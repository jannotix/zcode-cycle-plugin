<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><title>Cycle for Zcode - Rust dependency licenses</title></head>
<body>
<h1>Cycle for Zcode - Rust dependency licenses</h1>
<p>Generated from the locked Cargo dependency graph by cargo-about.</p>
{{#each licenses}}
{{#if first_of_kind}}<h2 id="{{id}}">{{name}}</h2>{{/if}}
<h3>Used by</h3>
<ul>{{#each used_by}}<li>{{crate.name}} {{crate.version}}</li>{{/each}}</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
