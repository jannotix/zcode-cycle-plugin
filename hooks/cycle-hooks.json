{
  "description": "Cycle role enforcement: managed project profiles provide the primary tool boundary; this Hook denies read-only mutations, delegation, unsafe executor Git and unregistered executor writes, then audits governed calls.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|ApplyPatch|NotebookEdit|Bash|Shell|Task|Agent|SubAgent",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/pre-tool-use.js"],
            "timeoutMs": 5000,
            "statusMessage": "ZCode Cycle: checking role boundaries"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/post-tool-use.js"],
            "timeoutMs": 5000,
            "statusMessage": "ZCode Cycle: recording tool audit"
          }
        ]
      }
    ]
  }
}
